{
	// Sublime Text preferences. Merged into Packages/User by scripts/install.py;
	// settings you already have (theme, colour scheme, font size) are kept.
	"translate_tabs_to_spaces": true,
	"tab_size": 2,
	"detect_indentation": true,
	"rulers": [80, 120],
	"trim_trailing_white_space_on_save": "all",
	"ensure_newline_at_eof_on_save": true,
	"highlight_line": true,
	"highlight_modified_tabs": true,
	"show_git_status": true,
	"save_on_focus_lost": true,
	"auto_complete_commit_on_tab": true,
	"auto_complete_with_fields": true,
	"auto_complete_triggers": [
		{ "selector": "text.html, text.xml", "characters": "<" },
		{ "selector": "source.js, source.ts, source.jsx, source.tsx, source.python, source.php, source.c++, source.c, source.cs", "characters": "." }
	],
	"shift_tab_unindent": true,
	"word_wrap": false,
	"folder_exclude_patterns": [".git", "node_modules", "__pycache__", ".next", "dist", "build", "bin", "obj", "vendor", ".venv"],
	"hardware_acceleration": "opengl"
}
