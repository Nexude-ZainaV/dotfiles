	<content><![CDATA[// throttle: run at most once per `limit` ms (scroll and mousemove handlers)
function throttle(fn, limit = ${1:200}) {
	let waiting = false;
	return (...args) => {
		if (waiting) return;
		fn(...args);
		waiting = true;
		setTimeout(() => (waiting = false), limit);
	};
}${0}]]></content>
