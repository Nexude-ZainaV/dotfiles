	<content><![CDATA[import time
from contextlib import contextmanager


@contextmanager
def timer(label: str):
	"""Usage: with timer("load"): do_work()"""
	start = time.perf_counter()
	try:
		yield
	finally:
		print(f"{label}: {(time.perf_counter() - start) * 1000:.1f} ms")
