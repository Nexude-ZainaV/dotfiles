<snippet>
	<content><![CDATA[// switch on an integer or enum. Each case needs `break` or it falls through.
switch (${1:value}) {
	case ${2:1}:
		${3}
		break;
	case ${4:2}:
		${5}
		break;
	default:   // runs when no case matches: handle the unexpected here
		${0}
		break;
}]]></content>
