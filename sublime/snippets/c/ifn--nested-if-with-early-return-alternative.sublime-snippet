	<content><![CDATA[// Nested if: the inner check only runs when the outer one passed
if (${1:ptr} != NULL) {
	if (${2:ptr->count > 0}) {
		${0}
	}
}
// Tip: deep nesting reads badly. Prefer guard clauses:
// if (ptr == NULL) return; if (!(ptr->count > 0)) return;]]></content>
