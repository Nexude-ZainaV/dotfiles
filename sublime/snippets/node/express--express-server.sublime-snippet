	<content><![CDATA[// server.js: Express app with the usual production middleware
import express from "express";
import helmet from "helmet";
import cors from "cors";

const app = express();
const PORT = Number(process.env.PORT) || ${1:3000};

app.use(helmet());                          // secure HTTP headers
app.use(cors({ origin: process.env.CORS_ORIGIN?.split(",") ?? false }));
app.use(express.json({ limit: "100kb" }));  // parse JSON bodies, cap the size

app.get("/health", (_req, res) => res.json({ status: "ok" }));
${0}

// 404 for anything not matched above
app.use((_req, res) => res.status(404).json({ error: "Not found" }));

// Error handler: 4 arguments is what marks it as one
app.use((err, _req, res, _next) => {
	console.error(err);
	res.status(err.status ?? 500).json({ error: err.expose ? err.message : "Internal error" });
});

app.listen(PORT, () => console.log(`listening on http://localhost:\${PORT}`));]]></content>
