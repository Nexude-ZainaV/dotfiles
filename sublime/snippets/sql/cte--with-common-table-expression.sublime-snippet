<snippet>
	<content><![CDATA[-- A CTE names a sub-result so the main query reads top-down instead of nested
WITH ${1:recent_orders} AS (
	SELECT customer_id, total
	FROM ${2:orders}
	WHERE created_at >= ${3:DATE '2026-01-01'}
)
SELECT customer_id, SUM(total) AS spent
FROM ${1}
GROUP BY customer_id;${0}]]></content>
