{
  "Standard includes": {
    "scope": "c",
    "prefix": "inc",
    "body": [
      "// ---- Standard library headers (C11) ----",
      "#include <stdio.h>    // printf, fprintf, fopen, fgets",
      "#include <stdlib.h>   // malloc, free, exit, EXIT_SUCCESS / EXIT_FAILURE",
      "#include <string.h>   // strlen, strncpy, strcmp, memset",
      "#include <stdbool.h>  // bool, true, false",
      "#include <stdint.h>   // fixed-width integers: int32_t, uint8_t",
      "#include <errno.h>    // errno is set by failing library calls",
      "${0}"
    ],
    "description": "Standard includes (guided)"
  },
  "main function": {
    "scope": "c",
    "prefix": "main",
    "body": [
      "// Entry point. argc = number of arguments, argv[0] = program name.",
      "int main(int argc, char *argv[])",
      "{",
      "\tif (argc < ${1:2}) {",
      "\t\tfprintf(stderr, \"usage: %s ${2:<arg>}\\\\n\", argv[0]);",
      "\t\treturn EXIT_FAILURE;   // non-zero exit tells the shell it failed",
      "\t}",
      "\t${0}",
      "\treturn EXIT_SUCCESS;",
      "}"
    ],
    "description": "main function (guided)"
  },
  "C program file": {
    "scope": "c",
    "prefix": "cfile",
    "body": [
      "/*",
      " * ${1:program}.c",
      " * Purpose: ${2:one line on what this program does}",
      " * Build:   gcc -std=c11 -Wall -Wextra -O2 -o ${1} ${1}.c",
      " */",
      "#include <stdio.h>",
      "#include <stdlib.h>",
      "#include <string.h>",
      "#include <stdbool.h>",
      "",
      "// ---- Prototypes: declare before main so main reads top-down ----",
      "static void ${3:run}(void);",
      "",
      "int main(void)",
      "{",
      "\t${3}();",
      "\treturn EXIT_SUCCESS;",
      "}",
      "",
      "// ---- Definitions ----",
      "static void ${3}(void)",
      "{",
      "\t${0}",
      "}"
    ],
    "description": "C program file (guided)",
    "isFileTemplate": true
  },
  "Header file with include guard": {
    "scope": "c",
    "prefix": "header",
    "body": [
      "// Include guard: stops this header being pasted twice into one translation unit",
      "#ifndef ${1:MODULE}_H",
      "#define ${1}_H",
      "",
      "#include <stddef.h>",
      "",
      "// Public API of ${1}: only declarations here, definitions live in the .c file",
      "${0}",
      "",
      "#endif // ${1}_H"
    ],
    "description": "Header file with include guard (guided)",
    "isFileTemplate": true
  },
  "if statement": {
    "scope": "c",
    "prefix": "if",
    "body": [
      "// if: run the block only when the condition is non-zero (true)",
      "if (${1:condition}) {",
      "\t${0}",
      "}"
    ],
    "description": "if statement (guided)"
  },
  "if / else": {
    "scope": "c",
    "prefix": "ife",
    "body": [
      "// if / else: exactly one of the two blocks runs",
      "if (${1:condition}) {",
      "\t${2}",
      "} else {",
      "\t${0}",
      "}"
    ],
    "description": "if / else (guided)"
  },
  "else-if chain": {
    "scope": "c",
    "prefix": "elif",
    "body": [
      "// else-if chain: tested top to bottom, first true branch wins",
      "if (${1:score} >= ${2:90}) {",
      "\t${3}",
      "} else if (${1} >= ${4:75}) {",
      "\t${5}",
      "} else {",
      "\t${0}",
      "}"
    ],
    "description": "else-if chain (guided)"
  },
  "Nested if with early-return alternative": {
    "scope": "c",
    "prefix": "ifn",
    "body": [
      "// Nested if: the inner check only runs when the outer one passed",
      "if (${1:ptr} != NULL) {",
      "\tif (${2:ptr->count > 0}) {",
      "\t\t${0}",
      "\t}",
      "}",
      "// Tip: deep nesting reads badly. Prefer guard clauses:",
      "// if (ptr == NULL) return; if (!(ptr->count > 0)) return;"
    ],
    "description": "Nested if with early-return alternative (guided)"
  },
  "Ternary operator": {
    "scope": "c",
    "prefix": "tern",
    "body": [
      "// ternary: condition ? value_if_true : value_if_false (an expression, not a statement)",
      "${1:int} ${2:result} = (${3:a > b}) ? ${4:a} : ${5:b};${0}"
    ],
    "description": "Ternary operator (guided)"
  },
  "switch statement": {
    "scope": "c",
    "prefix": "sw",
    "body": [
      "// switch on an integer or enum. Each case needs `break` or it falls through.",
      "switch (${1:value}) {",
      "\tcase ${2:1}:",
      "\t\t${3}",
      "\t\tbreak;",
      "\tcase ${4:2}:",
      "\t\t${5}",
      "\t\tbreak;",
      "\tdefault:   // runs when no case matches: handle the unexpected here",
      "\t\t${0}",
      "\t\tbreak;",
      "}"
    ],
    "description": "switch statement (guided)"
  },
  "for loop": {
    "scope": "c",
    "prefix": "for",
    "body": [
      "// for: init; condition checked before each pass; step after each pass",
      "for (size_t ${1:i} = 0; ${1} < ${2:count}; ${1}++) {",
      "\t${0}",
      "}"
    ],
    "description": "for loop (guided)"
  },
  "reverse for loop": {
    "scope": "c",
    "prefix": "forr",
    "body": [
      "// Reverse loop with size_t: count down using i-- > 0 because size_t never goes negative",
      "for (size_t ${1:i} = ${2:count}; ${1}-- > 0; ) {",
      "\t${0}",
      "}"
    ],
    "description": "reverse for loop (guided)"
  },
  "while loop": {
    "scope": "c",
    "prefix": "while",
    "body": [
      "// while: checks the condition first, so the body may run zero times",
      "while (${1:condition}) {",
      "\t${0}",
      "}"
    ],
    "description": "while loop (guided)"
  },
  "do-while loop": {
    "scope": "c",
    "prefix": "dowhile",
    "body": [
      "// do-while: body always runs at least once, condition checked after",
      "do {",
      "\t${0}",
      "} while (${1:condition});"
    ],
    "description": "do-while loop (guided)"
  },
  "function with doc comment": {
    "scope": "c",
    "prefix": "fn",
    "body": [
      "/**",
      " * ${2:What the function does in one sentence.}",
      " * @param ${3:value} ${4:meaning of the parameter}",
      " * @return ${5:what is returned, and what signals an error}",
      " */",
      "${1:int} ${6:function_name}(${7:int} ${3})",
      "{",
      "\t${0}",
      "}"
    ],
    "description": "function with doc comment (guided)"
  },
  "typedef struct": {
    "scope": "c",
    "prefix": "struct",
    "body": [
      "// typedef struct: lets you write `${1:Item}` instead of `struct ${1}`",
      "typedef struct ${1} {",
      "\t${2:int id;}",
      "\t${3:char name[64];}",
      "} ${1};${0}"
    ],
    "description": "typedef struct (guided)"
  },
  "typedef enum": {
    "scope": "c",
    "prefix": "enum",
    "body": [
      "// Named integer constants: clearer than magic numbers in a switch",
      "typedef enum {",
      "\t${1:STATE_IDLE},",
      "\t${2:STATE_RUNNING},",
      "\t${3:STATE_DONE}",
      "} ${4:State};${0}"
    ],
    "description": "typedef enum (guided)"
  },
  "malloc with NULL check": {
    "scope": "c",
    "prefix": "malloc",
    "body": [
      "// malloc can fail: always check for NULL, and free exactly once when done",
      "${1:int} *${2:buffer} = malloc(${3:count} * sizeof *${2});",
      "if (${2} == NULL) {",
      "\tperror(\"malloc\");",
      "\treturn EXIT_FAILURE;",
      "}",
      "${0}",
      "free(${2});",
      "${2} = NULL;   // avoid a dangling pointer being used after free"
    ],
    "description": "malloc with NULL check (guided)"
  },
  "open a file safely": {
    "scope": "c",
    "prefix": "fopen",
    "body": [
      "// fopen returns NULL on failure; perror prints the reason from errno",
      "FILE *${1:fp} = fopen(${2:\"data.txt\"}, ${3:\"r\"});",
      "if (${1} == NULL) {",
      "\tperror(${2});",
      "\treturn EXIT_FAILURE;",
      "}",
      "",
      "char ${4:line}[256];",
      "while (fgets(${4}, sizeof ${4}, ${1}) != NULL) {   // fgets is bounded, unlike gets",
      "\t${0}",
      "}",
      "",
      "fclose(${1});"
    ],
    "description": "open a file safely (guided)"
  },
  "read an integer safely": {
    "scope": "c",
    "prefix": "readint",
    "body": [
      "// Read a whole line with fgets, then parse it. Safer than scanf(\"%d\") on bad input.",
      "char ${1:buf}[64];",
      "long ${2:number} = 0;",
      "if (fgets(${1}, sizeof ${1}, stdin) != NULL) {",
      "\tchar *end = NULL;",
      "\terrno = 0;",
      "\t${2} = strtol(${1}, &end, 10);",
      "\tif (errno != 0 || end == ${1}) {",
      "\t\tfprintf(stderr, \"not a number\\\\n\");",
      "\t}",
      "}${0}"
    ],
    "description": "read an integer safely (guided)"
  },
  "measure elapsed time": {
    "scope": "c",
    "prefix": "timer",
    "body": [
      "#include <time.h>",
      "// clock() measures CPU time used by this process (not wall-clock time)",
      "clock_t ${1:start} = clock();",
      "",
      "${0}",
      "",
      "double ${2:elapsed_ms} = (double)(clock() - ${1}) * 1000.0 / CLOCKS_PER_SEC;",
      "printf(\"elapsed: %.3f ms\\\\n\", ${2});"
    ],
    "description": "measure elapsed time (guided)"
  },
  "array length macro": {
    "scope": "c",
    "prefix": "arrlen",
    "body": [
      "// Only works on real arrays, not on pointers passed into a function",
      "#define ARRAY_LEN(a) (sizeof(a) / sizeof((a)[0]))${0}"
    ],
    "description": "array length macro (guided)"
  },
  "printf with format guide": {
    "scope": "c",
    "prefix": "printf",
    "body": [
      "// %d int, %ld long, %zu size_t, %f double, %s string, %c char, %p pointer",
      "printf(\"${1:%s}\\\\n\", ${2:value});${0}"
    ],
    "description": "printf with format guide (guided)"
  }
}
