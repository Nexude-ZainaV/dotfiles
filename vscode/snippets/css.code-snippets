  "Container query": {
    "scope": "css,scss,less",
    "prefix": "cq",
    "body": [
      "/* Container queries: a component responds to ITS container's width, not the viewport,",
      "   so the same card works in a sidebar and in the main column. */",
      ".${1:card}-wrap {",
      "\tcontainer-type: inline-size;",
      "\tcontainer-name: ${1};",
      "}",
      "",
      "@container ${1} (min-width: ${2:420px}) {",
      "\t.${1} {",
      "\t\tdisplay: grid;",
      "\t\tgrid-template-columns: 160px 1fr;",
      "\t\t${0}",
      "\t}",
      "}"
    ],
    "description": "Container query (guided)"
  },
  "Fluid typography with clamp()": {
    "scope": "css,scss,less",
    "prefix": "clamp",
    "body": [
      "/* clamp(MIN, PREFERRED, MAX): scales with the viewport, never below MIN or above MAX.",
      "   rem-based min/max keep user font-size preferences working. */",
      "${1:h1} {",
      "\tfont-size: clamp(${2:1.75rem}, ${3:1.2rem + 2.5vw}, ${4:3rem});${0}",
      "}"
    ],
    "description": "Fluid typography with clamp() (guided)"
  },
  "Responsive grid (no media queries)": {
    "scope": "css,scss,less",
    "prefix": "grid",
    "body": [
      "/* auto-fit + minmax: as many columns as fit, each at least ${1:16rem} wide.",
      "   The grid reflows from 1 column on phones to 3-4 on desktop by itself. */",
      ".${2:grid} {",
      "\tdisplay: grid;",
      "\tgrid-template-columns: repeat(auto-fit, minmax(min(${1}, 100%), 1fr));",
      "\tgap: ${3:1.5rem};${0}",
      "}"
    ],
    "description": "Responsive grid (no media queries) (guided)"
  },
  "Flex center / row that wraps": {
    "scope": "css,scss,less",
    "prefix": "flexc",
    "body": [
      "/* Center anything horizontally and vertically */",
      ".${1:center} {",
      "\tdisplay: flex;",
      "\talign-items: center;",
      "\tjustify-content: center;",
      "}",
      "",
      "/* A row that wraps onto new lines on small screens */",
      ".${2:row} {",
      "\tdisplay: flex;",
      "\tflex-wrap: wrap;",
      "\tgap: ${3:1rem};${0}",
      "}"
    ],
    "description": "Flex center / row that wraps (guided)"
  },
  "Responsive page container": {
    "scope": "css,scss,less",
    "prefix": "container",
    "body": [
      "/* Centered, readable max width with side padding that grows on larger screens */",
      ".${1:container} {",
      "\twidth: min(100% - 2rem, ${2:72rem});",
      "\tmargin-inline: auto;${0}",
      "}"
    ],
    "description": "Responsive page container (guided)"
  },
  "Full-height section (mobile safe)": {
    "scope": "css,scss,less",
    "prefix": "vh",
    "body": [
      "/* 100vh is taller than the visible area on mobile (the URL bar). dvh tracks the real height. */",
      ".${1:hero} {",
      "\tmin-height: 100vh;   /* fallback for old browsers */",
      "\tmin-height: 100dvh;${0}",
      "}"
    ],
    "description": "Full-height section (mobile safe) (guided)"
  },
  "Visually hidden (screen-reader only)": {
    "scope": "css,scss,less",
    "prefix": "srtext",
    "body": [
      "/* Hidden visually but still read by screen readers (never use display:none for this) */",
      ".visually-hidden {",
      "\tposition: absolute !important;",
      "\twidth: 1px;",
      "\theight: 1px;",
      "\tpadding: 0;",
      "\tmargin: -1px;",
      "\toverflow: hidden;",
      "\tclip-path: inset(50%);",
      "\twhite-space: nowrap;",
      "\tborder: 0;",
      "}${0}"
    ],
    "description": "Visually hidden (screen-reader only) (guided)"
  },
