  "Media query: range syntax": {
    "scope": "css,scss,less",
    "prefix": "mqrange",
    "body": [
      "/* Media Queries Level 4 range syntax (all modern browsers): reads like maths */",
      "@media (${1:768px} <= width < ${2:1024px}) {   /* tablets only */",
      "\t${0}",
      "}"
