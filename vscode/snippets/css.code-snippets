  "Media query: touch vs mouse": {
    "scope": "css,scss,less",
    "prefix": "mqpointer",
    "body": [
      "/* Target the input device, not the screen size */",
      "@media (hover: hover) and (pointer: fine) {   /* mouse / trackpad */",
      "\t${1:.card}:hover { ${0} }",
      "}",
      "@media (pointer: coarse) {                     /* touch: bigger tap targets (44x44px minimum) */",
      "\tbutton, a { min-height: 44px; }",
      "}"
    ],
    "description": "Media query: touch vs mouse (guided)"
  },
  "Media query: reduced motion": {
    "scope": "css,scss,less",
    "prefix": "mqmotion",
    "body": [
      "/* Respect users who turned on \"reduce motion\" in their OS (vestibular disorders) */",
      "@media (prefers-reduced-motion: reduce) {",
      "\t*, *::before, *::after {",
      "\t\tanimation-duration: 0.01ms !important;",
      "\t\tanimation-iteration-count: 1 !important;",
      "\t\ttransition-duration: 0.01ms !important;",
      "\t\tscroll-behavior: auto !important;",
      "\t}",
      "}${0}"
    ],
    "description": "Media query: reduced motion (guided)"
  },
  "Media query: dark mode": {
    "scope": "css,scss,less",
    "prefix": "mqdark",
    "body": [
      "/* Follow the OS colour scheme through custom properties */",
      ":root {",
      "\t--bg: #ffffff;",
      "\t--fg: #1a1a1a;",
      "}",
      "@media (prefers-color-scheme: dark) {",
      "\t:root {",
      "\t\t--bg: #111418;",
      "\t\t--fg: #e8eaed;",
      "\t}",
      "}",
      "body { background: var(--bg); color: var(--fg); }${0}"
    ],
    "description": "Media query: dark mode (guided)"
  },
