  "Custom hook: useFetch": {
    "scope": "javascriptreact,typescriptreact",
    "prefix": "hookfetch",
    "body": [
      "import { useEffect, useState } from \"react\";",
      "",
      "// A custom hook is a function starting with `use` that reuses stateful logic",
      "export function useFetch<T>(url: string) {",
      "\tconst [data, setData] = useState<T | null>(null);",
      "\tconst [error, setError] = useState<string | null>(null);",
      "\tconst [loading, setLoading] = useState(true);",
      "",
      "\tuseEffect(() => {",
      "\t\tconst controller = new AbortController();",
      "\t\tsetLoading(true);",
      "\t\tfetch(url, { signal: controller.signal })",
      "\t\t\t.then((res) => {",
      "\t\t\t\tif (!res.ok) throw new Error(`HTTP \\${res.status}`);",
      "\t\t\t\treturn res.json() as Promise<T>;",
      "\t\t\t})",
      "\t\t\t.then(setData)",
      "\t\t\t.catch((err) => err.name !== \"AbortError\" && setError(err.message))",
      "\t\t\t.finally(() => setLoading(false));",
      "\t\treturn () => controller.abort();   // a new url cancels the old request",
      "\t}, [url]);",
      "",
      "\treturn { data, error, loading };",
      "}${0}"
    ],
    "description": "Custom hook: useFetch (guided)",
    "isFileTemplate": true
