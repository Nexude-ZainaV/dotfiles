  },
  "Native <dialog> modal": {
    "scope": "html,php",
    "prefix": "dialog",
    "body": [
      "<!-- Native <dialog>: focus trapping, Esc to close and a backdrop come built in -->",
      "<button type=\"button\" onclick=\"document.getElementById('${1:confirm}').showModal()\">${2:Open}</button>",
      "<dialog id=\"${1}\" aria-labelledby=\"${1}-title\">",
      "\t<h2 id=\"${1}-title\">${3:Are you sure?}</h2>",
      "\t<form method=\"dialog\">   <!-- method=\"dialog\" closes it and sets returnValue -->",
      "\t\t<button value=\"cancel\">Cancel</button>",
      "\t\t<button value=\"confirm\">Confirm</button>",
      "\t</form>",
      "\t${0}",
      "</dialog>"
    ],
    "description": "Native <dialog> modal (guided)"
  }
}
