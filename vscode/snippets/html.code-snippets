{
  "HTML5 responsive page": {
    "scope": "html,php",
    "prefix": "html5",
    "body": [
      "<!doctype html>",
      "<html lang=\"en\">",
      "<head>",
      "\t<meta charset=\"utf-8\">",
      "\t<!-- Responsive: without this, phones render a zoomed-out desktop page -->",
      "\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">",
      "\t<title>${1:Page title}</title>",
      "\t<meta name=\"description\" content=\"${2:150-160 characters that appear under the title in search results}\">",
      "",
      "\t<!-- Open Graph: the preview card when the link is shared -->",
      "\t<meta property=\"og:title\" content=\"${1}\">",
      "\t<meta property=\"og:description\" content=\"${2}\">",
      "\t<meta property=\"og:image\" content=\"${3:/og-image.png}\">",
      "",
      "\t<link rel=\"icon\" href=\"/favicon.svg\" type=\"image/svg+xml\">",
      "\t<link rel=\"stylesheet\" href=\"${4:css/styles.css}\">",
      "\t<!-- defer: download in parallel, run after the HTML is parsed -->",
      "\t<script src=\"${5:js/main.js}\" defer></script>",
      "</head>",
      "<body>",
      "\t<a class=\"skip-link\" href=\"#main\">Skip to content</a>",
      "\t<header></header>",
      "\t<main id=\"main\">",
      "\t\t${0}",
      "\t</main>",
      "\t<footer></footer>",
      "</body>",
      "</html>"
    ],
    "description": "HTML5 responsive page (guided)",
    "isFileTemplate": true
  },
